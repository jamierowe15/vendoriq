# Copy to .env.local (same folder) for local development. Vite only exposes VITE_ variables.
VITE_TENANT_ID=
VITE_SPA_CLIENT_ID=
VITE_API_CLIENT_ID=

# Leave empty locally (Vite proxies /api to Express). For Azure, put the API URL in
# .env.production, e.g. https://vendoriq-api-<unique>.azurewebsites.net
VITE_API_URL=
