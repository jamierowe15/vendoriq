# Copy this file to .env (same folder) and fill in your values. Never commit .env.

PORT=4000

# Local SQL Server Express
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=VendorIQ
DB_USER=vendoriq_app
DB_PASSWORD=Change_Me_123!
DB_ENCRYPT=false

# Entra ID (Day 3): Directory (tenant) ID and the VendorIQ API's Application (client) ID
TENANT_ID=
API_CLIENT_ID=

# React dev server allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# AI agent (Day 5): fill in ONE option
# Option A: OpenAI
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Option B: Azure OpenAI (then LLM_MODEL = your deployment name)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Slack alerts (Day 6, optional)
SLACK_WEBHOOK_URL=

# Public read-only demo (bonus). Leave false locally.
DEMO_MODE=false
DEMO_AGENT=false
